# Copy to .env (repository root) and replace every placeholder with a real value:
#   cp .env.example .env
# .env is read by Docker Compose (both stacks), by the backend when run on the host (`npm run dev`
# in backend/) and by the Vite dev server (VITE_* only). Never commit .env.
# CI copies this file as-is to boot the stack, so keep the required placeholders non-empty.

# =============================================================================================
# Docker Compose: host ports and dev tooling (read by `docker compose`, not by the apps)
# =============================================================================================
FRONTEND_PORT=3000
BACKEND_PORT=5000
MONGO_HOST_PORT=27017
MONGO_VERSION=7
# Poll for file changes in the dev containers. Needed for hot reload when the repository lives on
# a Windows drive (Docker Desktop / WSL bind mounts drop file events); "false" saves a little CPU
# on Linux/macOS or when the repo is inside the WSL filesystem.
WATCH_POLLING=true
# Containers reach MongoDB at mongodb://mongo:27017/ecommerce?replicaSet=rs0 by default. Set this
# to use another database instead (e.g. an Atlas replica set for docker-compose.prod.yml).
# DOCKER_DB_LOCAL=mongodb+srv://user:password@cluster.example.mongodb.net/ecommerce

# =============================================================================================
# Backend (all required unless marked optional; the API refuses to start if one is missing)
# Inside Docker, DB_LOCAL / PORT / MOOD / FE_URL / API_PUBLIC_URL are set by the compose file.
# =============================================================================================
PORT=5000
# DEV adds stack traces to error responses: only on your own machine (the dev stack sets it)
MOOD=PROD
APP_NAME=ecommerce

# ---- MongoDB: must be a replica set (transactions). This value is for running the backend on
# your host against the compose mongo service; directConnection is required from outside Docker.
DB_LOCAL=mongodb://localhost:27017/ecommerce?replicaSet=rs0&directConnection=true

# ---- Auth
# Prefix of the Authorization header ("<BEARER_KEY><token>"); also compiled into the frontend
BEARER_KEY=Bearer__
TOKEN_SIGNATURE=replace-with-a-long-random-string
EMAIL_TOKEN=replace-with-another-long-random-string
# bcrypt cost factor; values below 10 are raised to 10
SALT_ROUND=10
# Optional token lifetimes in seconds: access default 15 minutes, refresh default 30 days
# ACCESS_TOKEN_EXPIRES_IN=900
# REFRESH_TOKEN_EXPIRES_IN=2592000

# ---- Email: Gmail by default, or any SMTP provider (SES, SendGrid, Mailgun...) via SMTP_*
gmail=you@example.com
gmailPass=replace-with-gmail-app-password
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=replace-with-smtp-password
# MAIL_FROM="E-Commerce" <no-reply@example.com>

# ---- Cloudinary (image storage)
API_KEY=replace-with-cloudinary-api-key
API_SECRET=replace-with-cloudinary-api-secret
CLOUD_NAME=replace-with-cloudinary-cloud-name

# ---- Stripe
Secret_Key=sk_test_replace_me
endpointSecret=whsec_replace_me

# ---- Frontend origin: redirects after payment / email confirmation, and the default CORS origin
FE_URL=http://localhost:3000

# ---- HTTP (optional)
# Browser origins allowed by CORS, comma-separated; defaults to FE_URL. The bundled frontend calls
# the API through its own origin (/api proxy), so this only matters for other browser clients.
# CORS_ORIGINS=https://shop.example.com,https://admin.example.com
# Number of reverse proxies in front of the API (the prod stack sets 1 for its nginx). Rate limits
# are per client IP, so leave unset when clients connect directly or the IP could be spoofed.
# TRUST_PROXY=1
# Public base URL of the API, used for links in emails. Defaults to the request's own host; set it
# when the API is behind a proxy or path prefix (both compose stacks set it).
# API_PUBLIC_URL=https://shop.example.com/api

# ---- Optional - used in email templates
logo=
facebookLink=
instegram=
twitterLink=

# =============================================================================================
# Frontend (VITE_* are compiled into the browser bundle: never put secrets here)
# =============================================================================================
# Base URL of the API as seen by the browser. Keep the default /api (same origin, proxied by Vite
# in development and nginx in production) unless the API is on another browser-reachable origin.
# VITE_API_BASE_URL=/api
# Docker passes BEARER_KEY through automatically; set this only when running Vite on the host
# with a BEARER_KEY other than Bearer__.
# VITE_BEARER_KEY=Bearer__
