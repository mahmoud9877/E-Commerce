# Copy to config/.env and replace every placeholder with a real value.
# Never commit config/.env. Every key in the required sections must be set or the app will not start.
# CI also copies this file as-is to boot the app, so keep the placeholders non-empty.
PORT=5000
MOOD=DEV
APP_NAME=ecommerce

# ---- MongoDB (required) - must be a replica set (Atlas, or the docker-compose mongo service)
DB_LOCAL=mongodb://localhost:27017/ecommerce?replicaSet=rs0&directConnection=true

# ---- Auth (required)
BEARER_KEY=Bearer__
TOKEN_SIGNATURE=replace-with-a-long-random-string
EMAIL_TOKEN=replace-with-another-long-random-string
SALT_ROUND=8

# ---- Email / nodemailer (required)
gmail=you@example.com
gmailPass=replace-with-gmail-app-password

# ---- Cloudinary (required)
API_KEY=replace-with-cloudinary-api-key
API_SECRET=replace-with-cloudinary-api-secret
CLOUD_NAME=replace-with-cloudinary-cloud-name

# ---- Stripe (required)
Secret_Key=sk_test_replace_me
endpointSecret=whsec_replace_me

# ---- Frontend (required)
FE_URL=http://localhost:3000

# ---- Optional - used in email templates
logo=
facebookLink=
instegram=
twitterLink=

# ---- Docker Compose overrides (optional; put these in a root .env or your shell, not config/.env)
# DOCKER_DB_LOCAL=mongodb://mongo:27017/ecommerce?replicaSet=rs0
# API_HOST_PORT=5000
# MONGO_HOST_PORT=27017
# MONGO_VERSION=7
