# Production server for the frontend image. ${BACKEND_URL} and ${NGINX_RESOLVER} are filled in
# from the environment when the container starts (see Dockerfile); nginx's own $variables are
# left untouched because they are not environment variables.
server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    # The backend accepts up to 6 images x 5 MB per request
    client_max_body_size 32m;

    # Docker's DNS: re-resolve the backend periodically so a recreated backend container
    # (new IP) is picked up without restarting nginx
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

    # Security headers are set per location: an add_header in a location replaces inherited ones

    # API: same origin for the browser, forwarded to the backend with the /api prefix removed
    location /api/ {
        set $backend ${BACKEND_URL};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Fingerprinted build output: cache forever
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        try_files $uri =404;
    }

    # The app uses hash routing, but fall back to index.html for any other path anyway
    location / {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        try_files $uri $uri/ /index.html;
    }
}
